{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9999,
  "env": {
    "CONTEXT7_API_KEY": "<YOUR_CONTEXT7_API_KEY>",
    "EXA_API_KEY": "<YOUR_EXA_API_KEY>",
    "FIRECRAWL_API_KEY": "<YOUR_FIRECRAWL_API_KEY>",
    "GA4_PROPERTY_ID": "<YOUR_GA4_PROPERTY_ID>",
    "N8N_API_KEY": "<YOUR_N8N_API_KEY>",
    "DISCORD_WEBHOOK_URL": "<YOUR_DISCORD_WEBHOOK_URL>",
    "DISCORD_MENTION_USER": "<YOUR_DISCORD_USER_ID>",
    "NOTION_TASK_COLLECTION_URL": "<YOUR_NOTION_TASK_COLLECTION_URL>",
    "NOTION_NOTES_COLLECTION_URL": "<YOUR_NOTION_NOTES_COLLECTION_URL>",
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "false",
    "ECC_GATEGUARD": "off",
    "ECC_CONTEXT_WINDOW_TOKENS": "1000000"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "superpowers@superpowers-marketplace": true,
    "episodic-memory@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
